# Recoup Server Configuration
PORT=3000
NODE_ENV=development

# Razorpay Test Mode Credentials
# Provide your Razorpay Test Key ID and Secret below if available.
# When omitted, Recoup runs in fully deterministic high-fidelity Razorpay Test Mode simulation.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_TEST_MODE=true

# Anthropic Claude API Configuration (Phase 2B)
# Model: claude-haiku-4-5-20251001
# When omitted, Recoup runs using deterministic offline AI reasoning fallback.
ANTHROPIC_API_KEY=

# Database
DB_PATH=./recoup.sqlite
